{
  "name": "shotcraft-capability-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5181 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:web": "npm run build && node scripts/copy-web.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5182 --strictPort",
    "render": "remotion render src/render.tsx ShotcraftReel public/media/showcase.mp4 --scale=0.5 --concurrency=2"
  },
  "dependencies": {
    "@remotion/player": "4.0.484",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.484"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.484",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
